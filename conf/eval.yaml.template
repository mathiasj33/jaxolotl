defaults:
  - env: zone_env_nm
  - alg: struct_ltl
  - experiment: ${env}/${alg}
  - task_set: finite
  - formulas: ${env}/${task_set}
  - hydra: simple
  - _self_

run: pretrained
save: false

eval:
  finite: ${task_set.finite}
  num_episodes: 512
  deterministic: false
  discount: 0.94
  models_per_batch: all
  formulas_per_batch: all
  vmap_choose_subgoals: True
  vmap_choose_sequences: True
  checkpoint: null  # Load latest checkpoint
