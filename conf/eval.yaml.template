defaults:
  - env: zone_env_nm
  - alg: struct_ltl
  - experiment: ${env}/${alg}
  - formula_type: finite
  - formulas: ${env}/${formula_type}
  - hydra: simple
  - _self_

run: pretrained
eval:
  finite: ${formula_type.finite}
  num_episodes: 512
  deterministic: false
  discount: 0.94
  models_per_batch: all
  formulas_per_batch: all
  vmap_choose_subgoals: True
  vmap_choose_sequences: True
  checkpoint: null  # Load latest checkpoint
